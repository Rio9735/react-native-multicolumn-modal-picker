{
  "name": "react-native-multicolumn-modal-picker",
  "version": "1.1.0",
  "type": "commonjs",
  "description": "A customizable multi-column modal picker for React Native iOS, supporting up to 3 selection columns.",
  "main": "dist/index.js",
  "react-native": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "format": "npx --yes prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "npx --yes oxlint src",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "validate": "npm run format && npm run typecheck && npm run lint",
    "prepack": "npm run build",
    "prepublishOnly": "npm run validate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rio9735/react-native-multicolumn-modal-picker.git"
  },
  "keywords": [
    "react-native",
    "react native",
    "iOS",
    "picker",
    "selector",
    "modal",
    "column",
    "multi",
    "column-picker",
    "multicolumn",
    "multi-column",
    "multi-selector",
    "multiselector",
    "multi-picker",
    "multipicker",
    "configurable",
    "customizable"
  ],
  "author": "Marcos A. Del Río Rodríguez <marcosdelrio.dev@email.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Rio9735/react-native-multicolumn-modal-picker/issues"
  },
  "homepage": "https://github.com/Rio9735/react-native-multicolumn-modal-picker#readme",
  "engines": {
    "node": ">=24.21.0"
  },
  "dependencies": {
    "@react-native-picker/picker": "^2.11.4"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-native": ">=0.62.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "react-native": "^0.87.1",
    "typescript": "^7.0.2"
  }
}
