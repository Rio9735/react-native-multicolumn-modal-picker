{
  "name": "react-native-multicolumn-modal-picker",
  "version": "1.1.0",
  "description": "A customizable multi-column modal picker for React Native iOS, supporting up to 3 selection columns.",
  "license": "MIT",
  "author": "Marcos A. Del Río Rodríguez <marcosdelrio.dev@email.com>",
  "type": "commonjs",
  "sideEffects": false,
  "main": "dist/index.js",
  "react-native": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rio9735/react-native-multicolumn-modal-picker.git"
  },
  "homepage": "https://github.com/Rio9735/react-native-multicolumn-modal-picker",
  "bugs": {
    "url": "https://github.com/Rio9735/react-native-multicolumn-modal-picker/issues"
  },
  "keywords": [
    "react-native",
    "react native",
    "iOS",
    "picker",
    "selector",
    "modal",
    "column",
    "multi",
    "column-picker",
    "multicolumn",
    "multi-column",
    "multi-selector",
    "multiselector",
    "multi-picker",
    "multipicker",
    "configurable",
    "customizable"
  ],
  "scripts": {
    "format": "npx --yes prettier --write .",
    "format:check": "npx --yes prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "npx --yes oxlint src",
    "validate": "npm run format:check && npm run typecheck && npm run lint",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "example:local": "npm run build && npm pack && npm install --prefix example-app ./react-native-multicolumn-modal-picker-1.1.0.tgz --no-save --package-lock=false --ignore-scripts && node -e \"require('node:fs').rmSync('react-native-multicolumn-modal-picker-1.1.0.tgz',{force:true})\" && npm --prefix example-app start",
    "example:restore": "npm install --prefix example-app --ignore-scripts"
  },
  "dependencies": {},
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-native": ">=0.62.0",
    "@react-native-picker/picker": ">=2.0.0",
    "react-native-safe-area-context": ">= 4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "react-native": "^0.87.1",
    "typescript": "^7.0.2"
  }
}
